---
import Button from '@astro-v7/shared/components/Button.astro';
import Card from '@astro-v7/shared/components/Card.astro';
import Navbar from '@astro-v7/shared/components/Navbar.astro';
import ThemeToggle from '@astro-v7/shared/components/ThemeToggle.svelte';
import { localePath } from '@astro-v7/shared/utils/i18n';
import { env } from '@/env';
import { t } from '@/i18n';
import StarterLayout from '@/layouts/StarterLayout.astro';
import '@/styles/app.css';

const locale = 'de' as const;
const tr = t(locale);

const links = [
  { href: localePath('/', locale), label: tr('nav.home') },
  { href: localePath('/contact', locale), label: tr('nav.contact') },
];
---

<StarterLayout title={tr('home.title')} description={tr('home.description')} lang={locale} siteName={env.PUBLIC_SITE_NAME} ogImage={new URL('/og/de/home.png', Astro.site).href}>

  <Navbar slot="header" siteName="Astro v7" links={links}>
    <a href="/" class="text-xs font-medium text-text-secondary hover:text-text no-underline">EN</a>
    <ThemeToggle client:load />
  </Navbar>

  <section class="mx-auto max-w-3xl px-6 py-16 text-center">
    <h1 class="mb-4 text-[clamp(2rem,5vw,3.5rem)] font-extrabold leading-tight tracking-tight">{tr('home.title')}</h1>
    <p class="mb-8 text-xl text-text-secondary">{tr('home.description')}</p>
    <div class="flex flex-wrap justify-center gap-4">
      <Button href="https://docs.astro.build" target="_blank" rel="noopener noreferrer">
        {tr('home.cta.docs')}
      </Button>
      <Button href={localePath('/contact', locale)} variant="secondary">
        {tr('home.cta.contact')}
      </Button>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-12">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <Card>
        <h2 class="mb-2 text-xl font-bold">{tr('feature.astro.title')}</h2>
        <p class="leading-relaxed text-text-secondary">{tr('feature.astro.desc')}</p>
      </Card>
      <Card>
        <h2 class="mb-2 text-xl font-bold">{tr('feature.tailwind.title')}</h2>
        <p class="leading-relaxed text-text-secondary">{tr('feature.tailwind.desc')}</p>
      </Card>
      <Card>
        <h2 class="mb-2 text-xl font-bold">{tr('feature.svelte.title')}</h2>
        <p class="leading-relaxed text-text-secondary">{tr('feature.svelte.desc')}</p>
      </Card>
      <Card>
        <h2 class="mb-2 text-xl font-bold">{tr('feature.biome.title')}</h2>
        <p class="leading-relaxed text-text-secondary">{tr('feature.biome.desc')}</p>
      </Card>
      <Card>
        <h2 class="mb-2 text-xl font-bold">{tr('feature.zod.title')}</h2>
        <p class="leading-relaxed text-text-secondary">{tr('feature.zod.desc')}</p>
      </Card>
      <Card>
        <h2 class="mb-2 text-xl font-bold">{tr('feature.darkmode.title')}</h2>
        <p class="leading-relaxed text-text-secondary">{tr('feature.darkmode.desc')}</p>
      </Card>
      <Card>
        <h2 class="mb-2 text-xl font-bold">{tr('feature.webvitals.title')}</h2>
        <p class="leading-relaxed text-text-secondary">{tr('feature.webvitals.desc')}</p>
      </Card>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-20">
    <h2 class="mb-2 text-2xl font-bold">{tr('demo.title')}</h2>
    <p class="mb-8 text-text-secondary">{tr('demo.description')}</p>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <div class="props-tilt rounded-xl border border-border bg-surface p-8" data-props-for="pointer-local">
        <h3 class="mb-2 text-lg font-bold">{tr('demo.pointer.title')}</h3>
        <p class="text-text-secondary">{tr('demo.pointer.desc')}</p>
      </div>
      <div class="rounded-xl border border-border bg-surface p-8" data-props-for="visibility">
        <h3 class="mb-2 text-lg font-bold">{tr('demo.scroll.title')}</h3>
        <p class="text-text-secondary">{tr('demo.scroll.desc')}</p>
      </div>
      <div class="rounded-xl border border-border bg-surface p-8">
        <h3 class="mb-2 text-lg font-bold">{tr('demo.range.title')}</h3>
        <p class="text-text-secondary">{tr('demo.range.desc')}</p>
        <div data-props-for="range">
          <input type="range" min="0" max="100" value="40" class="w-full" aria-label={tr('demo.range.title')} />
          <div class="props-range-track"><div class="props-range-fill"></div></div>
        </div>
      </div>
      <div class="rounded-xl border border-border bg-surface p-8" data-props-for="scroll-velocity">
        <h3 class="mb-2 text-lg font-bold">{tr('demo.scrollvelocity.title')}</h3>
        <p class="text-text-secondary">{tr('demo.scrollvelocity.desc')}</p>
        <div class="props-scroll-meter"><div class="props-scroll-meter-fill"></div></div>
      </div>
      <div class="flex items-center gap-6 rounded-xl border border-border bg-surface p-8" data-props-for="clock">
        <div class="props-clock-face" aria-hidden="true"><div class="props-clock-hand"></div></div>
        <div>
          <h3 class="mb-2 text-lg font-bold">{tr('demo.clock.title')}</h3>
          <p class="text-text-secondary">{tr('demo.clock.desc')}</p>
        </div>
      </div>
      <div class="rounded-xl border border-border bg-surface p-8">
        <h3 class="mb-2 text-lg font-bold">{tr('demo.random.title')}</h3>
        <p class="text-text-secondary">{tr('demo.random.desc')}</p>
        <div class="props-random-grid" aria-hidden="true">
          {Array.from({ length: 12 }).map(() => (
            <span class="props-random-dot" data-props-for="random" />
          ))}
        </div>
      </div>
      <div class="rounded-xl border border-border bg-surface p-8" data-props-for="viewport">
        <h3 class="mb-2 text-lg font-bold">{tr('demo.viewport.title')}</h3>
        <p class="text-text-secondary">{tr('demo.viewport.desc')}</p>
        <p class="props-viewport-readout" aria-hidden="true"></p>
      </div>
      <div class="rounded-xl border border-border bg-surface p-8">
        <h3 class="mb-2 text-lg font-bold">{tr('demo.size.title')}</h3>
        <p class="text-text-secondary">{tr('demo.size.desc')}</p>
        <div class="props-resize-box" data-props-for="size">
          <span class="props-resize-readout" aria-hidden="true"></span>
        </div>
      </div>
      <div class="rounded-xl border border-border bg-surface p-8">
        <h3 class="mb-2 text-lg font-bold">{tr('demo.truncated.title')}</h3>
        <p class="text-text-secondary">{tr('demo.truncated.desc')}</p>
        <div class="props-truncate-demo">
          <p class="props-truncate-text" data-props-for="truncated" data-props-to=".props-truncate-demo">{tr('demo.truncated.sample')}</p>
          <span class="props-truncate-badge">{tr('demo.truncated.badge')}</span>
        </div>
      </div>
      <div class="rounded-xl border border-border bg-surface p-8">
        <h3 class="mb-2 text-lg font-bold">{tr('demo.color.title')}</h3>
        <p class="text-text-secondary">{tr('demo.color.desc')}</p>
        <div class="props-color-demo" data-props-for="color-input">
          <input type="color" value="#2f7ed8" aria-label={tr('demo.color.title')} />
          <div class="props-color-swatch" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>

  <footer slot="footer" class="border-t border-border px-6 py-8 text-center text-sm text-text-secondary">
    <p>&copy; {new Date().getFullYear()} Astro v7 Starter. {tr('footer.built')} <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>.</p>
  </footer>
</StarterLayout>
