---
import { cn } from '../utils/cn';

interface Props {
  class?: string;
  href?: string;
}

const { class: className, href } = Astro.props;

const classes = cn(
  'border-border bg-surface rounded-xl border p-8 transition-all',
  href ? 'hover:border-accent block text-inherit no-underline hover:shadow-md' : 'hover:shadow-md',
  className
);
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <article class={classes}>
    <slot />
  </article>
)}
