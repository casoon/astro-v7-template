---
import {
  ArticleSchema,
  OrganizationSchema,
  WebPageSchema,
  WebSiteSchema,
} from '@casoon/astro-structured-data/components';
import { siteProfile } from '../config/site';

export interface Props {
  title: string;
  description?: string;
  lang?: string;
  siteName?: string;
  ogImage?: string;
  robots?: string;
  articleAuthor?: string;
  articleDate?: Date;
  articleModified?: Date;
}

const {
  title,
  description = '',
  lang = 'en',
  siteName,
  ogImage,
  robots,
  articleAuthor,
  articleDate,
  articleModified,
} = Astro.props;

const useArticleSchema = !!articleDate && !!ogImage;
const logoUrl = new URL(siteProfile.logoPath, Astro.site).href;
// Pages without their own OG image (e.g. 404) fall back to the home image.
const pageImage = ogImage ?? new URL('/og/home.png', Astro.site).href;
const publisherName = siteName ?? Astro.site?.hostname ?? 'Website';
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      function getStoredTheme() {
        try {
          const cookieTheme = document.cookie.match(/(?:^|;\s*)theme=(dark|light)(?:;|$)/)?.[1];
          return cookieTheme || localStorage.getItem('theme');
        } catch {
          return null;
        }
      }

      function applyTheme() {
        document.documentElement.classList.remove('no-js');
        const storedTheme = getStoredTheme();
        if (
          storedTheme === 'dark' ||
          (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      }

      applyTheme();
      if (window.__applyThemeHandler) {
        document.removeEventListener('astro:after-swap', window.__applyThemeHandler);
      }
      window.__applyThemeHandler = applyTheme;
      document.addEventListener('astro:after-swap', window.__applyThemeHandler);
    </script>
    {robots && <meta name="robots" content={robots} />}
    {useArticleSchema ? (
      <ArticleSchema
        title={title}
        description={description}
        datePublished={articleDate!.toISOString()}
        dateModified={articleModified?.toISOString()}
        authorName={articleAuthor ?? 'Unknown'}
        imageUrl={ogImage!}
        publisherName={publisherName}
        publisherLogo={logoUrl}
      />
    ) : (
      <WebPageSchema
        title={title}
        description={description}
        image={pageImage}
        datePublished={siteProfile.launchDate}
        dateModified={new Date()}
        author={{ name: publisherName, type: 'Organization' }}
      />
    )}
    {siteName && <WebSiteSchema name={siteName} />}
    {siteName && (
      <OrganizationSchema
        name={siteName}
        url={Astro.site?.href}
        logoUrl={logoUrl}
        email={siteProfile.email}
        telephone={siteProfile.telephone}
        address={siteProfile.address}
        sameAs={siteProfile.sameAs}
      />
    )}
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
